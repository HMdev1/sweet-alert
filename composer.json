{
  "name": "hmdev1/sweet-alert",
  "description": "A simple PHP package to show Sweet Alerts with the Laravel Framework",
  "keywords": [
    "laravel",
    "alert",
    "sweet",
    "notifier"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Uziel Bueno",
      "email": "ux.webs@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/session": "^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "mockery/mockery": "^1.6",
    "friendsofphp/php-cs-fixer": "^3.66"
  },
  "autoload": {
    "psr-4": {
      "UxWeb\\SweetAlert\\": "src/SweetAlert/"
    },
    "files": [
      "src/SweetAlert/functions.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "UxWeb\\SweetAlert\\SweetAlertServiceProvider"
      ],
      "aliases": {
        "Alert": "UxWeb\\SweetAlert\\SweetAlert"
      }
    }
  },
  "replace": {
    "yousefyahya/sweet-alert": "self.version"
  }
}
